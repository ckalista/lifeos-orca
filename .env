# Pin a stable release for repeatable builds. Use "latest" to resolve the
# newest stable release whenever Coolify performs an uncached image build.
ORCA_VERSION=1.4.177

# Orca listens on this TCP port inside the container and on the host.
ORCA_PORT=6768

# The Docker bind must be a literal host IP. The pairing address may instead be
# a Tailscale MagicDNS hostname if preferred. Never bind to the host's public IP
# or to 0.0.0.0.
ORCA_BIND_ADDRESS=100.83.19.5
ORCA_PAIRING_ADDRESS=100.83.19.5

# The container's unprivileged user. Defaults work for new named volumes.
ORCA_UID=1000
ORCA_GID=1000

TZ=Europe/London

# Optional. Prefer `orca account add` for managed provider accounts. These are
# useful for agent CLIs that authenticate directly through environment values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GH_TOKEN=
